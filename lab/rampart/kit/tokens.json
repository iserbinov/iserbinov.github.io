  "dimension": {
    "control.height-m": 40,
    "control.height-l": 48,
    "control.padding-x": "{space.4}",
    "control.radius": "{radius.m}",
    "control.border-width": 1,
    "focus.width": 2,
    "focus.offset": 2,
    "target.min": 24,
    "card.padding": "{space.8}",
    "card.padding-compact": "{space.6}",
    "card.radius": "{radius.l}",
    "card.width": 400,
    "form.gap": "{space.4}",
    "field.gap": "{space.2}",
    "checkbox.size": 20,
    "code.cell": 48
