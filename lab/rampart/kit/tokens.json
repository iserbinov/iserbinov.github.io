      "border.focus": "{color.amber.300}",
      "action.primary": "{color.amber.400}",
      "action.primary-hover": "{color.amber.300}",
      "action.primary-pressed": "{color.amber.200}",
      "action.secondary-hover": "{color.graphite.800}",
      "action.secondary-pressed": "{color.graphite.700}",
      "status.error": "{color.red.300}",
      "status.error-bg": "{color.red.950}",
      "status.success": "{color.green.300}",
      "status.success-bg": "{color.green.950}",
      "status.warning": "{color.orange.300}",
      "status.warning-bg": "{color.orange.950}",
      "status.info": "{color.blue.300}",
      "status.info-bg": "{color.blue.950}",
      "brand.bar-1": "{color.amber.400}",
      "brand.bar-2": "{color.graphite.300}",
      "brand.bar-3": "{color.graphite.500}",
      "brand.panel": "{color.graphite.800}",
      "brand.panel-text": "{color.graphite.50}",
      "brand.panel-text-secondary": "{color.graphite.300}"
