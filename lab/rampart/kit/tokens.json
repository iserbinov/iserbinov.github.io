      "lineHeight": {
        "16": 16,
        "20": 20,
        "24": 24,
        "28": 28,
        "36": 36
      },
      "weight": {
        "regular": 400,
        "medium": 500,
        "semibold": 600
      }
    }
  },
  "semantic": {
