  "component": {
    "button.primary.bg": "{action.primary}",
    "button.primary.bg-hover": "{action.primary-hover}",
    "button.primary.bg-pressed": "{action.primary-pressed}",
    "button.primary.text": "{text.on-action}",
    "button.secondary.bg-hover": "{action.secondary-hover}",
    "button.secondary.bg-pressed": "{action.secondary-pressed}",
    "button.secondary.border": "{border.default}",
    "button.secondary.text": "{text.primary}",
    "button.disabled.bg": "{bg.disabled}",
    "button.disabled.text": "{text.disabled}",
    "field.bg": "{bg.surface}",
