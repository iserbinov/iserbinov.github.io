    "field.border": "{border.default}",
    "field.border-hover": "{border.hover}",
    "field.border-focus": "{border.focus}",
    "field.border-error": "{status.error}",
    "field.text": "{text.primary}",
    "field.placeholder": "{text.secondary}",
    "field.label": "{text.primary}",
    "field.hint": "{text.secondary}",
    "field.error": "{status.error}",
    "checkbox.border": "{border.default}",
