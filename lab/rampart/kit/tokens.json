    "checkbox.mark": "{text.on-action}",
    "link.text": "{text.link}",
    "link.text-hover": "{text.link-hover}",
    "alert.text": "{text.primary}",
    "focus.ring": "{border.focus}",
    "card.bg": "{bg.surface}",
    "card.border": "{border.subtle}",
    "divider.line": "{border.subtle}",
    "divider.text": "{text.secondary}",
    "layout.bg": "{bg.page}",
    "layout.panel-bg": "{brand.panel}",
    "layout.panel-text": "{brand.panel-text}",
    "layout.panel-text-secondary": "{brand.panel-text-secondary}"
