        "600": "#1E7F46",
        "950": "#0F2A1C"
      },
      "orange": {
        "50": "#FDF0E8",
        "300": "#FF9B6B",
        "600": "#C2410C",
        "950": "#3A1C0C"
      },
      "blue": {
        "50": "#EAF0FD",
        "300": "#8DB2F7",
        "600": "#2459D6",
        "950": "#14213F"
      }
    },
    "space": {
      "0": 0,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "8": 32,
      "10": 40,
      "12": 48,
      "16": 64
    },
    "radius": {
      "s": 4,
      "m": 8,
      "l": 16,
      "full": 999
