  "primitive": {
    "color": {
      "white": "#FFFFFF",
      "graphite": {
        "50": "#F6F7F8",
        "100": "#ECEEF0",
        "200": "#DADDE1",
        "300": "#BFC4CA",
        "400": "#9AA1A9",
        "500": "#767E87",
        "600": "#5B626A",
        "700": "#444A51",
        "800": "#2E3338",
        "900": "#1E2226",
        "950": "#14171A"
      },
      "amber": {
        "50": "#FFF7E6",
        "100": "#FFEBC2",
        "200": "#FFD98A",
        "300": "#FFC44D",
        "400": "#FFB01F",
        "500": "#F59E0B",
        "600": "#D97F06",
        "700": "#A85A07",
        "800": "#82450B",
        "900": "#6E3B0F"
      },
      "red": {
        "50": "#FDEDEE",
        "300": "#FF8F8F",
        "600": "#C8262F",
        "950": "#3B1518"
      },
      "green": {
        "50": "#E8F5EE",
